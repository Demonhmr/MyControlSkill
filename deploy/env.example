# Настройки службы. Копируется в /etc/mycontrolskill/env.
#
#   sudo install -D -m 0600 -o root -g root deploy/env.example /etc/mycontrolskill/env
#
# Режим 0600 обязателен: здесь лежит пароль от почты.

# Сервис слушает только петлю — наружу его выставляет обратный прокси.
MCS_ADDR=127.0.0.1:8080

# Каталог создаёт systemd (StateDirectory), владелец — служба.
MCS_DB_PATH=/var/lib/mycontrolskill/mycontrolskill.db

# Сборка фронтенда.
MCS_STATIC_DIR=/opt/mycontrolskill/web

# Внешний адрес. Попадает в ссылки писем, поэтому должен совпадать с тем,
# что видит пользователь. По схеме https включается флаг Secure у cookie.
MCS_BASE_URL=https://compass.example.com

# Перед сервисом стоит прокси, поэтому адрес клиента берётся из
# X-Forwarded-For. Без прокси это включать нельзя: заголовок подделывается,
# и ограничение частоты по адресу обходится.
MCS_TRUST_PROXY=true

# Кто может завести аккаунт. Если обе переменные пусты, аккаунт заведёт
# любой, кто знает адрес сервиса. Ограничивается заведение, а не вход:
# у кого аккаунт уже есть, тот входит всегда.
MCS_ALLOWED_DOMAINS=company.ru
MCS_ALLOWED_EMAILS=

# Срок хранения раундов 360° в днях. Ноль или пусто — хранить бессрочно.
# Удаляются раунды, а не аккаунты: обратная связь стареет, кабинет нет.
# Чистку выполняет таймер mycontrolskill-purge.timer.
MCS_RETENTION_DAYS=0

# Почта. Без MCS_SMTP_HOST письма не отправляются, а ссылки пишутся в лог —
# войти сможет только тот, у кого есть доступ к логам.
MCS_SMTP_HOST=smtp.example.com
MCS_SMTP_PORT=587
MCS_SMTP_SECURITY=starttls
MCS_SMTP_USER=no-reply@example.com
MCS_SMTP_PASSWORD=замените
MCS_SMTP_FROM=Компас руководителя <no-reply@example.com>
