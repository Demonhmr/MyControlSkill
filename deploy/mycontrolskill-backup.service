# Разовая задача: копия базы. Запускается таймером, см. соседний .timer.
[Unit]
Description=Копия базы «Компаса руководителя»
After=mycontrolskill.service

[Service]
Type=oneshot
User=mycontrolskill
Group=mycontrolskill

# Тот же файл окружения, что у службы: путь к базе должен совпадать.
EnvironmentFile=/etc/mycontrolskill/env
ExecStart=/opt/mycontrolskill/bin/backup.sh

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/mycontrolskill
StateDirectory=mycontrolskill
